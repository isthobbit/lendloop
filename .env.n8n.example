# Copy to .env.n8n (git-ignored). Generate values with: node scripts/gen-secrets.mjs

# Encrypts credentials stored by n8n. Keep it stable; losing it loses saved credentials.
N8N_ENCRYPTION_KEY=

# Where n8n calls Convex HTTP actions (note: .convex.site, not .convex.cloud).
# Local Convex backend from Docker: http://host.docker.internal:3211
LENDLOOP_CONVEX_SITE_URL=https://your-deployment.convex.site

# Verifies webhooks FROM Convex. Must match Convex's CONVEX_TO_N8N_KEYS.
# Format: keyId:secret[,keyId:secret]  (first = active; more = accepted during rotation)
LENDLOOP_C2N_KEYS=

# Signs requests TO Convex. Must match Convex's N8N_TO_CONVEX_KEYS.
LENDLOOP_N2C_KEYS=

# Optional: public URL from the tunnel profile, so a cloud Convex can reach n8n.
# N8N_PUBLIC_URL=https://something.trycloudflare.com/
